#!/bin/bash
# Shortcut, not a build: runs add-ons/reader/reader.py from the repo this app lives in.
# Output goes to ~/.boku/logs/reader.log.
REPO="$(cd "$(dirname "$0")/../../../.." && pwd -P)"
mkdir -p "$HOME/.boku/logs"
exec >>"$HOME/.boku/logs/reader.log" 2>&1
cd "$REPO" || exit 1
# exec keeps the same process, so the Dock shows this app's icon.
if [ -x .venv/bin/python ]; then
    exec .venv/bin/python add-ons/reader/reader.py
fi
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"
exec uv run python add-ons/reader/reader.py
